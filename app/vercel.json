{
  "rewrites": [
    { "source": "/jobs/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/jobs/:file(.*\\..*)", "destination": "/:file" },
    { "source": "/jobs", "destination": "/index.html" },
    { "source": "/jobs/(.*)", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
